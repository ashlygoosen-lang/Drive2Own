PORT=4000
# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Where the frontend is served from (CORS)
CLIENT_ORIGIN=http://localhost:5173
# Where the SQLite database and uploaded files are stored
DATA_DIR=./data

# --- Online payments (PayFast). Leave blank to keep payments manual. ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# 1 = use the PayFast sandbox
PAYFAST_SANDBOX=1
# Public URL of this API (PayFast calls /api/payfast/itn on it) and of the website
PUBLIC_API_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:5173

# --- SMS (Twilio). Leave blank to log SMS to the console in development. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# 1 = owners cannot hand over a vehicle until the driver's ID, licence and PrDP are verified by an admin
REQUIRE_VERIFIED_DOCS=0
